# On Railway: DATABASE_URL = ${{Postgres.DATABASE_URL}} (reference variable). Never commit real values.
DATABASE_URL=postgresql://app:change_me@localhost:5432/solana_intel
DASHBOARD_PASSWORD=change_me_long_random
APP_TIMEZONE=Asia/Karachi

RUN_COLLECTOR=true
ENABLE_PUMPFUN_DISCOVERY=true
ENABLE_DEXSCREENER_ENRICHMENT=true

# view filters only (never ingestion filters)
DISCOVERY_MAX_TOKEN_AGE_MINUTES=20
CANDIDATE_MIN_LIQUIDITY_USD=1000
CANDIDATE_MIN_MARKET_CAP_USD=800000
CANDIDATE_MAX_MARKET_CAP_USD=1000000000

# monitoring / storage knobs
MONITOR_ALL_TOKENS_HOURS=24
MONITOR_ALL_TOKENS_EXTENDED_DAYS=0
SNAPSHOT_SCALE=1.0
